diff --git a/src/ggml-metal/ggml-metal.cpp b/src/ggml-metal/ggml-metal.cpp
index ac9213b4..ec772d0e 100644
--- a/src/ggml-metal/ggml-metal.cpp
+++ b/src/ggml-metal/ggml-metal.cpp
@@ -949,6 +949,20 @@ static void ggml_backend_metal_fusion_set_enabled(ggml_backend_fusion_t finfo, b
     ggml_metal_fusion_info_set_enabled((struct ggml_metal_fusion_info *) finfo, enabled);
 }
 
+// Context-Assist (F4): flush the pipeline cache of every Metal device without
+// freeing it. Call only while no computation runs. 0 — ok, -1 — a write failed.
+static int ggml_backend_metal_pipeline_cache_flush(void) {
+    ggml_backend_reg_t reg = ggml_backend_metal_reg();
+    int rc = 0;
+    for (size_t i = 0; i < ggml_backend_reg_dev_count(reg); ++i) {
+        ggml_backend_dev_t dev = ggml_backend_reg_dev_get(reg, i);
+        if (ggml_metal_device_pipeline_cache_flush((ggml_metal_device_t) dev->context) != 0) {
+            rc = -1;
+        }
+    }
+    return rc;
+}
